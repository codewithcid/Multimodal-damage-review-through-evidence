# Copy to code/.env (or repo-root .env) and fill in. Never commit the real file.

# Google AI Studio API key for Gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# GOOGLE_API_KEY is also accepted as an alias.

# --- Optional overrides (defaults shown) ---
# EVIDENCE_MODEL=gemini-2.5-flash
# EVIDENCE_MAX_WORKERS=4
# EVIDENCE_MAX_IMAGE_LONG_EDGE=1024
# EVIDENCE_JPEG_QUALITY=85
# EVIDENCE_TEMPERATURE=0
